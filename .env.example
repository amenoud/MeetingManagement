# Example configuration. FAKE VALUES ONLY: this repository is public.
# Optional: copy to .env (git-ignored) to override the docker-compose defaults.
NODE_ENV=development
PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_only
POSTGRES_DB=meetingmanagement
# 5433 (not 5432) to avoid clashing with a local PostgreSQL.
DB_PORT=5433
DATABASE_URL=postgres://postgres:postgres_dev_only@localhost:5433/meetingmanagement

S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=meetingmanagement-dev
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey_only

SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_FROM=noreply@meetingmanagement.test
