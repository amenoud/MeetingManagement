{
  "name": "meeting-management",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "type": "module",
  "description": "Multi-tenant committee meeting management",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "db:bootstrap": "node --env-file-if-exists=.env scripts/db-bootstrap.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:setup": "pnpm db:bootstrap && pnpm db:migrate",
    "test:integration": "vitest run --config vitest.integration.config.ts tests/integration",
    "test:isolation": "vitest run --config vitest.integration.config.ts tests/isolation",
    "db:backup": "node --env-file-if-exists=.env scripts/db-backup.ts",
    "db:restore": "node --env-file-if-exists=.env scripts/db-restore.ts",
    "db:verify-restore": "node --env-file-if-exists=.env scripts/db-verify-restore.ts",
    "db:drill": "node scripts/db-drill.ts",
    "db:audit": "node --env-file-if-exists=.env scripts/db-audit.ts",
    "check:actions": "node scripts/check-actions-pinned.ts",
    "test:docker": "node scripts/docker-smoke.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
